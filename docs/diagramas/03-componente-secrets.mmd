classDiagram
    direction TB
    class ISecretStore {
        <<interface provida>>
        +read(path, version) Secret
        +write(path, data) int
        +list(path) list
        +delete(path)
    }
    class IVaultTransport {
        <<interface requerida>>
    }
    class ITokenProvider {
        <<interface requerida>>
        +get_token() str
    }
    class KVv2SecretStore {
        +mount: str
        GET /v1/mount/data/path
        POST /v1/mount/data/path
        LIST /v1/mount/metadata/path
    }
    class Secret {
        <<frozen>>
        +path: str
        +data: dict  «oculto no repr»
        +version: int
        +created_time: str
        +value(key) Any
        +keys() list
        +describe() dict
    }
    class SecretRef {
        <<frozen>>
        +path: str
        +key: str
        +version: int
        +mount: str
        +parse(raw)$ SecretRef
        +cache_key() str
    }
    ISecretStore <|.. KVv2SecretStore
    KVv2SecretStore --> IVaultTransport
    KVv2SecretStore --> ITokenProvider
    ISecretStore ..> Secret : devolve
